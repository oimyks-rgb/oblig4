# Copy to .env and fill in. Never commit .env.

# Neo4j AuraDB connection (from the Aura console)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Flask session signing key (any long random string)
SECRET_KEY=

# Passwords given to the seeded test users
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Pictures (A2). IMAGE_GENERATOR: gemini, fake (local test pictures, free) or empty (upload only)
IMAGE_GENERATOR=
# Gemini API key from Google AI Studio. Image models have no free tier (about $0.034 per picture).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
