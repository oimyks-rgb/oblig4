<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_asis" targetNamespace="http://ektemat.example/bpmn" exporter="EkteMat team" exporterVersion="1.0">
  <bpmn:collaboration id="collab_asis">
    <bpmn:participant id="p_cust" name="Customer" processRef="proc_p_cust" />
    <bpmn:participant id="p_ekte" name="Ekte Mat AS (today: e-mail, phone, Excel, paper)" processRef="proc_p_ekte" />
    <bpmn:messageFlow id="mf_1" name="Request" sourceRef="c_send" targetRef="e_start" />
    <bpmn:messageFlow id="mf_2" name="Quote (PDF)" sourceRef="e_quote" targetRef="c_quote" />
    <bpmn:messageFlow id="mf_3" name="Acceptance" sourceRef="c_accept" targetRef="e_acc" />
    <bpmn:messageFlow id="mf_4" name="Deposit request" sourceRef="e_dep" targetRef="c_dep" />
    <bpmn:messageFlow id="mf_5" name="Changes" sourceRef="c_chg" targetRef="e_upd" />
    <bpmn:messageFlow id="mf_6" name="Confirmation call" sourceRef="e_call" targetRef="c_final" />
    <bpmn:messageFlow id="mf_7" name="Food" sourceRef="d_deliv" targetRef="c_deliv" />
    <bpmn:messageFlow id="mf_8" name="Invoice / Vipps request" sourceRef="e_inv" targetRef="c_inv" />
    <bpmn:messageFlow id="mf_9" name="Payment" sourceRef="c_pay" targetRef="o_rec" />
    <bpmn:textAnnotation id="legend_asis"><bpmn:text>AS-IS legend: red task = step that causes a problem reported by a stakeholder (P1-P11). See 02_table_asis-problems-to-user-stories_2026-10-20.md for the problem and the user story that fixes it. Sources: 02_process_as-is-order-handling_2026-08-15.md and the four interviews.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="proc_p_cust" isExecutable="false">
    <bpmn:laneSet id="ls_p_cust">
      <bpmn:lane id="l_cust" name="Private or corporate customer">
        <bpmn:flowNodeRef>c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_wed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_wed_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_chg_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c_start" name="Catering needed">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="c_send" name="[P1] Send request by e-mail or phone">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="c_quote" name="Quote received">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_quote" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="c_gw_acc" name="Accept quote?">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="c_end_no" name="Booked elsewhere">
      <bpmn:incoming>sf_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="c_accept" name="Accept quote by e-mail">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw_wed" name="Wedding?">
      <bpmn:incoming>sf_6</bpmn:incoming>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c_dep" name="Pay deposit in Vipps">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw_wed_m" name="">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="c_gw_chg" name="Changes needed?">
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c_chg" name="Phone / e-mail changes (guests, allergies)">
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw_chg_m" name="">
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c_final" name="Give final numbers on the phone">
      <bpmn:incoming>sf_14</bpmn:incoming>
      <bpmn:outgoing>sf_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="c_deliv" name="Food delivered">
      <bpmn:incoming>sf_15</bpmn:incoming>
      <bpmn:outgoing>sf_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_deliv" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_inv" name="Invoice / Vipps request received">
      <bpmn:incoming>sf_16</bpmn:incoming>
      <bpmn:outgoing>sf_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_inv" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c_pay" name="Pay">
      <bpmn:incoming>sf_17</bpmn:incoming>
      <bpmn:outgoing>sf_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_end" name="Order paid">
      <bpmn:incoming>sf_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_1" name="" sourceRef="c_start" targetRef="c_send" />
    <bpmn:sequenceFlow id="sf_2" name="" sourceRef="c_send" targetRef="c_quote" />
    <bpmn:sequenceFlow id="sf_3" name="" sourceRef="c_quote" targetRef="c_gw_acc" />
    <bpmn:sequenceFlow id="sf_4" name="No" sourceRef="c_gw_acc" targetRef="c_end_no" />
    <bpmn:sequenceFlow id="sf_5" name="Yes" sourceRef="c_gw_acc" targetRef="c_accept" />
    <bpmn:sequenceFlow id="sf_6" name="" sourceRef="c_accept" targetRef="c_gw_wed" />
    <bpmn:sequenceFlow id="sf_7" name="Yes" sourceRef="c_gw_wed" targetRef="c_dep" />
    <bpmn:sequenceFlow id="sf_8" name="No" sourceRef="c_gw_wed" targetRef="c_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_9" name="" sourceRef="c_dep" targetRef="c_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_10" name="" sourceRef="c_gw_wed_m" targetRef="c_gw_chg" />
    <bpmn:sequenceFlow id="sf_11" name="Yes" sourceRef="c_gw_chg" targetRef="c_chg" />
    <bpmn:sequenceFlow id="sf_12" name="No" sourceRef="c_gw_chg" targetRef="c_gw_chg_m" />
    <bpmn:sequenceFlow id="sf_13" name="" sourceRef="c_chg" targetRef="c_gw_chg_m" />
    <bpmn:sequenceFlow id="sf_14" name="" sourceRef="c_gw_chg_m" targetRef="c_final" />
    <bpmn:sequenceFlow id="sf_15" name="" sourceRef="c_final" targetRef="c_deliv" />
    <bpmn:sequenceFlow id="sf_16" name="" sourceRef="c_deliv" targetRef="c_inv" />
    <bpmn:sequenceFlow id="sf_17" name="" sourceRef="c_inv" targetRef="c_pay" />
    <bpmn:sequenceFlow id="sf_18" name="" sourceRef="c_pay" targetRef="c_end" />
  </bpmn:process>
  <bpmn:process id="proc_p_ekte" isExecutable="false">
    <bpmn:laneSet id="ls_p_ekte">
      <bpmn:lane id="l_coord" name="Event coordinator">
        <bpmn:flowNodeRef>e_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_cap_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end_lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_excel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_wed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_wed_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_chg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_gw_chg_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_inv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>k_prep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_driver" name="Driver">
        <bpmn:flowNodeRef>d_deliv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_owner" name="Owner">
        <bpmn:flowNodeRef>o_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Request received">
      <bpmn:outgoing>sf_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_e_start" />
    </bpmn:startEvent>
    <bpmn:task id="e_read" name="[P2] Read e-mail / note phone call on paper (1-7 days)">
      <bpmn:incoming>sf_19</bpmn:incoming>
      <bpmn:outgoing>sf_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="e_cal" name="[P3] Check Google Calendar for capacity (gut feeling)">
      <bpmn:incoming>sf_20</bpmn:incoming>
      <bpmn:outgoing>sf_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="e_gw_cap" name="Capacity on date?">
      <bpmn:incoming>sf_21</bpmn:incoming>
      <bpmn:outgoing>sf_22</bpmn:outgoing>
      <bpmn:outgoing>sf_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e_alt" name="Propose another date">
      <bpmn:incoming>sf_23</bpmn:incoming>
      <bpmn:outgoing>sf_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="e_gw_cap_m" name="">
      <bpmn:incoming>sf_22</bpmn:incoming>
      <bpmn:incoming>sf_24</bpmn:incoming>
      <bpmn:outgoing>sf_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e_quote" name="[P4] Write quote in Word, e-mail as PDF">
      <bpmn:incoming>sf_25</bpmn:incoming>
      <bpmn:outgoing>sf_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="e_evgw" name="">
      <bpmn:incoming>sf_26</bpmn:incoming>
      <bpmn:outgoing>sf_27</bpmn:outgoing>
      <bpmn:outgoing>sf_28</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="e_acc" name="Acceptance received">
      <bpmn:incoming>sf_27</bpmn:incoming>
      <bpmn:outgoing>sf_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_e_acc" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e_timer" name="No reply">
      <bpmn:incoming>sf_28</bpmn:incoming>
      <bpmn:outgoing>sf_29</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_e_timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_end_lapsed" name="Request lapsed">
      <bpmn:incoming>sf_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="e_excel" name="[P5] Add row to Excel 'Bestillinger'">
      <bpmn:incoming>sf_30</bpmn:incoming>
      <bpmn:outgoing>sf_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="e_gw_wed" name="Wedding?">
      <bpmn:incoming>sf_31</bpmn:incoming>
      <bpmn:outgoing>sf_32</bpmn:outgoing>
      <bpmn:outgoing>sf_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e_dep" name="[P6] Send Vipps deposit request (sometimes forgotten)">
      <bpmn:incoming>sf_32</bpmn:incoming>
      <bpmn:outgoing>sf_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="e_gw_wed_m" name="">
      <bpmn:incoming>sf_33</bpmn:incoming>
      <bpmn:incoming>sf_34</bpmn:incoming>
      <bpmn:outgoing>sf_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e_print" name="[P7] Print order, pin on kitchen board">
      <bpmn:incoming>sf_35</bpmn:incoming>
      <bpmn:outgoing>sf_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="e_gw_chg" name="Changes received?">
      <bpmn:incoming>sf_36</bpmn:incoming>
      <bpmn:outgoing>sf_37</bpmn:outgoing>
      <bpmn:outgoing>sf_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e_upd" name="[P8] Update Excel and re-print (sometimes forgotten)">
      <bpmn:incoming>sf_37</bpmn:incoming>
      <bpmn:outgoing>sf_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="e_gw_chg_m" name="">
      <bpmn:incoming>sf_38</bpmn:incoming>
      <bpmn:incoming>sf_39</bpmn:incoming>
      <bpmn:outgoing>sf_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e_call" name="[P9] Phone customer 7 days before (if time)">
      <bpmn:incoming>sf_40</bpmn:incoming>
      <bpmn:outgoing>sf_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="k_prep" name="[P10] Prepare food from printout">
      <bpmn:incoming>sf_41</bpmn:incoming>
      <bpmn:outgoing>sf_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="d_deliv" name="Deliver; address from printout">
      <bpmn:incoming>sf_42</bpmn:incoming>
      <bpmn:outgoing>sf_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="e_inv" name="[P11] Create invoice in Fiken / Vipps request by hand">
      <bpmn:incoming>sf_43</bpmn:incoming>
      <bpmn:outgoing>sf_44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="o_rec" name="Reconcile Fiken with Excel (monthly)">
      <bpmn:incoming>sf_44</bpmn:incoming>
      <bpmn:outgoing>sf_45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="o_end" name="Order closed">
      <bpmn:incoming>sf_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_19" name="" sourceRef="e_start" targetRef="e_read" />
    <bpmn:sequenceFlow id="sf_20" name="" sourceRef="e_read" targetRef="e_cal" />
    <bpmn:sequenceFlow id="sf_21" name="" sourceRef="e_cal" targetRef="e_gw_cap" />
    <bpmn:sequenceFlow id="sf_22" name="Yes" sourceRef="e_gw_cap" targetRef="e_gw_cap_m" />
    <bpmn:sequenceFlow id="sf_23" name="No" sourceRef="e_gw_cap" targetRef="e_alt" />
    <bpmn:sequenceFlow id="sf_24" name="" sourceRef="e_alt" targetRef="e_gw_cap_m" />
    <bpmn:sequenceFlow id="sf_25" name="" sourceRef="e_gw_cap_m" targetRef="e_quote" />
    <bpmn:sequenceFlow id="sf_26" name="" sourceRef="e_quote" targetRef="e_evgw" />
    <bpmn:sequenceFlow id="sf_27" name="" sourceRef="e_evgw" targetRef="e_acc" />
    <bpmn:sequenceFlow id="sf_28" name="" sourceRef="e_evgw" targetRef="e_timer" />
    <bpmn:sequenceFlow id="sf_29" name="" sourceRef="e_timer" targetRef="e_end_lapsed" />
    <bpmn:sequenceFlow id="sf_30" name="" sourceRef="e_acc" targetRef="e_excel" />
    <bpmn:sequenceFlow id="sf_31" name="" sourceRef="e_excel" targetRef="e_gw_wed" />
    <bpmn:sequenceFlow id="sf_32" name="Yes" sourceRef="e_gw_wed" targetRef="e_dep" />
    <bpmn:sequenceFlow id="sf_33" name="No" sourceRef="e_gw_wed" targetRef="e_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_34" name="" sourceRef="e_dep" targetRef="e_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_35" name="" sourceRef="e_gw_wed_m" targetRef="e_print" />
    <bpmn:sequenceFlow id="sf_36" name="" sourceRef="e_print" targetRef="e_gw_chg" />
    <bpmn:sequenceFlow id="sf_37" name="Yes" sourceRef="e_gw_chg" targetRef="e_upd" />
    <bpmn:sequenceFlow id="sf_38" name="No" sourceRef="e_gw_chg" targetRef="e_gw_chg_m" />
    <bpmn:sequenceFlow id="sf_39" name="" sourceRef="e_upd" targetRef="e_gw_chg_m" />
    <bpmn:sequenceFlow id="sf_40" name="" sourceRef="e_gw_chg_m" targetRef="e_call" />
    <bpmn:sequenceFlow id="sf_41" name="" sourceRef="e_call" targetRef="k_prep" />
    <bpmn:sequenceFlow id="sf_42" name="" sourceRef="k_prep" targetRef="d_deliv" />
    <bpmn:sequenceFlow id="sf_43" name="" sourceRef="d_deliv" targetRef="e_inv" />
    <bpmn:sequenceFlow id="sf_44" name="" sourceRef="e_inv" targetRef="o_rec" />
    <bpmn:sequenceFlow id="sf_45" name="" sourceRef="o_rec" targetRef="o_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_asis">
    <bpmndi:BPMNPlane id="plane_asis" bpmnElement="collab_asis">
      <bpmndi:BPMNShape id="p_cust_di" bpmnElement="p_cust" isHorizontal="true"><dc:Bounds x="20" y="20" width="3750" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l_cust_di" bpmnElement="l_cust" isHorizontal="true"><dc:Bounds x="50" y="20" width="3720" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_ekte_di" bpmnElement="p_ekte" isHorizontal="true"><dc:Bounds x="20" y="280" width="3750" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l_coord_di" bpmnElement="l_coord" isHorizontal="true"><dc:Bounds x="50" y="280" width="3720" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l_kitchen_di" bpmnElement="l_kitchen" isHorizontal="true"><dc:Bounds x="50" y="490" width="3720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l_driver_di" bpmnElement="l_driver" isHorizontal="true"><dc:Bounds x="50" y="620" width="3720" height="130" /></bpmndi:BPMNShape>
