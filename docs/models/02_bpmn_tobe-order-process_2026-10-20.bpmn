<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="defs_tobe" targetNamespace="http://ektemat.example/bpmn" exporter="EkteMat team" exporterVersion="1.0">
  <bpmn:collaboration id="collab_tobe">
    <bpmn:participant id="p_ext" name="Fiken / Vipps (external services)" />
    <bpmn:participant id="p_cust" name="Customer" processRef="proc_p_cust" />
    <bpmn:participant id="p_ekte" name="Ekte Mat AS" processRef="proc_p_ekte" />
    <bpmn:messageFlow id="mf_1" name="Booking request" sourceRef="c_submit" targetRef="s_start" />
    <bpmn:messageFlow id="mf_2" name="Acknowledgement" sourceRef="s_reg" targetRef="c_ack" />
    <bpmn:messageFlow id="mf_3" name="Quote" sourceRef="s_quote" targetRef="c_quote" />
    <bpmn:messageFlow id="mf_4" name="Acceptance" sourceRef="c_accept" targetRef="s_acc" />
    <bpmn:messageFlow id="mf_5" name="Vipps request" sourceRef="s_dep" targetRef="c_dep" />
    <bpmn:messageFlow id="mf_6" name="Deposit" sourceRef="c_dep" targetRef="p_ext" />
    <bpmn:messageFlow id="mf_7" name="Payment status" sourceRef="p_ext" targetRef="s_dep_paid" />
    <bpmn:messageFlow id="mf_8" name="Reminder" sourceRef="s_rem" targetRef="c_rem" />
    <bpmn:messageFlow id="mf_9" name="Final numbers" sourceRef="c_final" targetRef="s_final" />
    <bpmn:messageFlow id="mf_10" name="Food" sourceRef="d_deliv" targetRef="c_deliv" />
    <bpmn:messageFlow id="mf_11" name="Invoice data" sourceRef="s_inv" targetRef="p_ext" />
    <bpmn:messageFlow id="mf_12" name="EHF / receipt" sourceRef="p_ext" targetRef="c_inv" />
    <bpmn:messageFlow id="mf_13" name="Payment" sourceRef="c_pay" targetRef="p_ext" />
    <bpmn:messageFlow id="mf_14" name="Payment status" sourceRef="p_ext" targetRef="s_sync" />
    <bpmn:textAnnotation id="legend_tobe"><bpmn:text>TO-BE legend: blue = task done automatically by Ekte Mat Online. (US-xx) = user story in 01_Requirements/EkteMat_backlog_v1.xlsx that delivers the step. Fiken / Vipps is a black-box pool (external services).</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="proc_p_cust" isExecutable="false">
    <bpmn:laneSet id="ls_p_cust">
      <bpmn:lane id="l_cust" name="Private or corporate customer">
        <bpmn:flowNodeRef>c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_browse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_wed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw_wed_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c_start" name="Catering needed">
      <bpmn:outgoing>sf_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="c_browse" name="Browse menus, prices and free dates online (US-01/04/05)">
      <bpmn:incoming>sf_1</bpmn:incoming>
      <bpmn:outgoing>sf_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c_submit" name="Submit booking request online (US-02)">
      <bpmn:incoming>sf_2</bpmn:incoming>
      <bpmn:outgoing>sf_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="c_ack" name="Acknowledgement received">
      <bpmn:incoming>sf_3</bpmn:incoming>
      <bpmn:outgoing>sf_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_ack" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_quote" name="Quote received">
      <bpmn:incoming>sf_4</bpmn:incoming>
      <bpmn:outgoing>sf_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_quote" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="c_gw_acc" name="Accept quote?">
      <bpmn:incoming>sf_5</bpmn:incoming>
      <bpmn:outgoing>sf_6</bpmn:outgoing>
      <bpmn:outgoing>sf_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="c_end_no" name="Declined">
      <bpmn:incoming>sf_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="c_accept" name="Accept quote online">
      <bpmn:incoming>sf_7</bpmn:incoming>
      <bpmn:outgoing>sf_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw_wed" name="Wedding?">
      <bpmn:incoming>sf_8</bpmn:incoming>
      <bpmn:outgoing>sf_9</bpmn:outgoing>
      <bpmn:outgoing>sf_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c_dep" name="Pay 30 % deposit in Vipps (US-22)">
      <bpmn:incoming>sf_9</bpmn:incoming>
      <bpmn:outgoing>sf_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw_wed_m" name="">
      <bpmn:incoming>sf_10</bpmn:incoming>
      <bpmn:incoming>sf_11</bpmn:incoming>
      <bpmn:outgoing>sf_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="c_rem" name="Reminder received">
      <bpmn:incoming>sf_12</bpmn:incoming>
      <bpmn:outgoing>sf_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_rem" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c_final" name="Confirm / adjust guests and allergies online (US-11)">
      <bpmn:incoming>sf_13</bpmn:incoming>
      <bpmn:outgoing>sf_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="c_deliv" name="Food delivered">
      <bpmn:incoming>sf_14</bpmn:incoming>
      <bpmn:outgoing>sf_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_deliv" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_inv" name="Invoice / receipt received">
      <bpmn:incoming>sf_15</bpmn:incoming>
      <bpmn:outgoing>sf_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c_inv" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c_pay" name="Pay (Vipps or EHF invoice)">
      <bpmn:incoming>sf_16</bpmn:incoming>
      <bpmn:outgoing>sf_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_end" name="Order paid">
      <bpmn:incoming>sf_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_1" name="" sourceRef="c_start" targetRef="c_browse" />
    <bpmn:sequenceFlow id="sf_2" name="" sourceRef="c_browse" targetRef="c_submit" />
    <bpmn:sequenceFlow id="sf_3" name="" sourceRef="c_submit" targetRef="c_ack" />
    <bpmn:sequenceFlow id="sf_4" name="" sourceRef="c_ack" targetRef="c_quote" />
    <bpmn:sequenceFlow id="sf_5" name="" sourceRef="c_quote" targetRef="c_gw_acc" />
    <bpmn:sequenceFlow id="sf_6" name="No" sourceRef="c_gw_acc" targetRef="c_end_no" />
    <bpmn:sequenceFlow id="sf_7" name="Yes" sourceRef="c_gw_acc" targetRef="c_accept" />
    <bpmn:sequenceFlow id="sf_8" name="" sourceRef="c_accept" targetRef="c_gw_wed" />
    <bpmn:sequenceFlow id="sf_9" name="Yes" sourceRef="c_gw_wed" targetRef="c_dep" />
    <bpmn:sequenceFlow id="sf_10" name="No" sourceRef="c_gw_wed" targetRef="c_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_11" name="" sourceRef="c_dep" targetRef="c_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_12" name="" sourceRef="c_gw_wed_m" targetRef="c_rem" />
    <bpmn:sequenceFlow id="sf_13" name="" sourceRef="c_rem" targetRef="c_final" />
    <bpmn:sequenceFlow id="sf_14" name="" sourceRef="c_final" targetRef="c_deliv" />
    <bpmn:sequenceFlow id="sf_15" name="" sourceRef="c_deliv" targetRef="c_inv" />
    <bpmn:sequenceFlow id="sf_16" name="" sourceRef="c_inv" targetRef="c_pay" />
    <bpmn:sequenceFlow id="sf_17" name="" sourceRef="c_pay" targetRef="c_end" />
  </bpmn:process>
  <bpmn:process id="proc_p_ekte" isExecutable="false">
    <bpmn:laneSet id="ls_p_ekte">
      <bpmn:lane id="l_sys" name="Ekte Mat Online">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>co_gw_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end_lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw_wed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_dep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_dep_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw_wed_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_sync</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_coord" name="Event coordinator">
        <bpmn:flowNodeRef>co_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>co_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>k_allerg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_cook</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_driver" name="Driver">
        <bpmn:flowNodeRef>d_deliv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_owner" name="Owner">
        <bpmn:flowNodeRef>o_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Booking request received">
      <bpmn:outgoing>sf_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_s_start" />
    </bpmn:startEvent>
    <bpmn:task id="s_reg" name="Register request, send acknowledgement (US-02/03)">
      <bpmn:incoming>sf_18</bpmn:incoming>
      <bpmn:outgoing>sf_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_cap" name="Check capacity: 400 / 250 covers (US-10)">
      <bpmn:incoming>sf_19</bpmn:incoming>
      <bpmn:outgoing>sf_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_gw_cap" name="Within capacity?">
      <bpmn:incoming>sf_20</bpmn:incoming>
      <bpmn:outgoing>sf_21</bpmn:outgoing>
      <bpmn:outgoing>sf_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="co_alt" name="Propose other date or approve override (US-10)">
      <bpmn:incoming>sf_21</bpmn:incoming>
      <bpmn:outgoing>sf_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="co_gw_m" name="">
      <bpmn:incoming>sf_22</bpmn:incoming>
      <bpmn:incoming>sf_23</bpmn:incoming>
      <bpmn:outgoing>sf_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="co_review" name="Review request in order list, approve quote (US-08/06)">
      <bpmn:incoming>sf_24</bpmn:incoming>
      <bpmn:outgoing>sf_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_quote" name="Send quote and confirmation (US-03/06)">
      <bpmn:incoming>sf_25</bpmn:incoming>
      <bpmn:outgoing>sf_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="s_evgw" name="">
      <bpmn:incoming>sf_26</bpmn:incoming>
      <bpmn:outgoing>sf_27</bpmn:outgoing>
      <bpmn:outgoing>sf_28</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="s_acc" name="Quote accepted">
      <bpmn:incoming>sf_27</bpmn:incoming>
      <bpmn:outgoing>sf_30</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_s_acc" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="s_timer" name="No reply in 7 days">
      <bpmn:incoming>sf_28</bpmn:incoming>
      <bpmn:outgoing>sf_29</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_s_timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="s_end_lapsed" name="Request lapsed">
      <bpmn:incoming>sf_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="s_order" name="Create order; update capacity and kitchen screen (US-08/26)">
      <bpmn:incoming>sf_30</bpmn:incoming>
      <bpmn:outgoing>sf_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_gw_wed" name="Wedding?">
      <bpmn:incoming>sf_31</bpmn:incoming>
      <bpmn:outgoing>sf_32</bpmn:outgoing>
      <bpmn:outgoing>sf_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_dep" name="Send 30 % deposit request via Vipps (US-22)">
      <bpmn:incoming>sf_32</bpmn:incoming>
      <bpmn:outgoing>sf_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="s_dep_paid" name="Deposit paid">
      <bpmn:incoming>sf_34</bpmn:incoming>
      <bpmn:outgoing>sf_35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_s_dep_paid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="s_gw_wed_m" name="">
      <bpmn:incoming>sf_33</bpmn:incoming>
      <bpmn:incoming>sf_35</bpmn:incoming>
      <bpmn:outgoing>sf_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="k_allerg" name="Confirm allergies seen on kitchen screen (US-27)">
      <bpmn:incoming>sf_36</bpmn:incoming>
      <bpmn:outgoing>sf_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="s_t7" name="7 days before event">
      <bpmn:incoming>sf_37</bpmn:incoming>
      <bpmn:outgoing>sf_38</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_s_t7" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="s_rem" name="Send reminder to confirm final numbers (US-12)">
      <bpmn:incoming>sf_38</bpmn:incoming>
      <bpmn:outgoing>sf_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="s_final" name="Final numbers confirmed">
      <bpmn:incoming>sf_39</bpmn:incoming>
      <bpmn:outgoing>sf_40</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_s_final" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="s_prep" name="Update kitchen view and 3-day prep list (US-26/29)">
      <bpmn:incoming>sf_40</bpmn:incoming>
      <bpmn:outgoing>sf_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="k_cook" name="Prepare food from kitchen screen, works offline (US-26/30)">
      <bpmn:incoming>sf_41</bpmn:incoming>
      <bpmn:outgoing>sf_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="d_deliv" name="Deliver using delivery list on phone (US-15)">
      <bpmn:incoming>sf_42</bpmn:incoming>
      <bpmn:outgoing>sf_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_inv" name="Create invoice in Fiken: Vipps or monthly EHF (US-21/23/24)">
      <bpmn:incoming>sf_43</bpmn:incoming>
      <bpmn:outgoing>sf_44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_sync" name="Sync payment status from Fiken / Vipps (US-25)">
      <bpmn:incoming>sf_44</bpmn:incoming>
      <bpmn:outgoing>sf_45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="o_check" name="Check payment exceptions on overview (US-25)">
      <bpmn:incoming>sf_45</bpmn:incoming>
      <bpmn:outgoing>sf_46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="o_end" name="Order closed">
      <bpmn:incoming>sf_46</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf_18" name="" sourceRef="s_start" targetRef="s_reg" />
    <bpmn:sequenceFlow id="sf_19" name="" sourceRef="s_reg" targetRef="s_cap" />
    <bpmn:sequenceFlow id="sf_20" name="" sourceRef="s_cap" targetRef="s_gw_cap" />
    <bpmn:sequenceFlow id="sf_21" name="No" sourceRef="s_gw_cap" targetRef="co_alt" />
    <bpmn:sequenceFlow id="sf_22" name="Yes" sourceRef="s_gw_cap" targetRef="co_gw_m" />
    <bpmn:sequenceFlow id="sf_23" name="" sourceRef="co_alt" targetRef="co_gw_m" />
    <bpmn:sequenceFlow id="sf_24" name="" sourceRef="co_gw_m" targetRef="co_review" />
    <bpmn:sequenceFlow id="sf_25" name="" sourceRef="co_review" targetRef="s_quote" />
    <bpmn:sequenceFlow id="sf_26" name="" sourceRef="s_quote" targetRef="s_evgw" />
    <bpmn:sequenceFlow id="sf_27" name="" sourceRef="s_evgw" targetRef="s_acc" />
    <bpmn:sequenceFlow id="sf_28" name="" sourceRef="s_evgw" targetRef="s_timer" />
    <bpmn:sequenceFlow id="sf_29" name="" sourceRef="s_timer" targetRef="s_end_lapsed" />
    <bpmn:sequenceFlow id="sf_30" name="" sourceRef="s_acc" targetRef="s_order" />
    <bpmn:sequenceFlow id="sf_31" name="" sourceRef="s_order" targetRef="s_gw_wed" />
    <bpmn:sequenceFlow id="sf_32" name="Yes" sourceRef="s_gw_wed" targetRef="s_dep" />
    <bpmn:sequenceFlow id="sf_33" name="No" sourceRef="s_gw_wed" targetRef="s_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_34" name="" sourceRef="s_dep" targetRef="s_dep_paid" />
    <bpmn:sequenceFlow id="sf_35" name="" sourceRef="s_dep_paid" targetRef="s_gw_wed_m" />
    <bpmn:sequenceFlow id="sf_36" name="" sourceRef="s_gw_wed_m" targetRef="k_allerg" />
    <bpmn:sequenceFlow id="sf_37" name="" sourceRef="k_allerg" targetRef="s_t7" />
    <bpmn:sequenceFlow id="sf_38" name="" sourceRef="s_t7" targetRef="s_rem" />
    <bpmn:sequenceFlow id="sf_39" name="" sourceRef="s_rem" targetRef="s_final" />
    <bpmn:sequenceFlow id="sf_40" name="" sourceRef="s_final" targetRef="s_prep" />
    <bpmn:sequenceFlow id="sf_41" name="" sourceRef="s_prep" targetRef="k_cook" />
    <bpmn:sequenceFlow id="sf_42" name="" sourceRef="k_cook" targetRef="d_deliv" />
    <bpmn:sequenceFlow id="sf_43" name="" sourceRef="d_deliv" targetRef="s_inv" />
    <bpmn:sequenceFlow id="sf_44" name="" sourceRef="s_inv" targetRef="s_sync" />
    <bpmn:sequenceFlow id="sf_45" name="" sourceRef="s_sync" targetRef="o_check" />
    <bpmn:sequenceFlow id="sf_46" name="" sourceRef="o_check" targetRef="o_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_tobe">
