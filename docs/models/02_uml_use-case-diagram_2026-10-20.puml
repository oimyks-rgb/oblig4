@startuml
' Use case diagram - Ekte Mat Online (Must + Should stories, backlog v1)
' Each use case carries its traceability in the note text: [US-xx]
title Ekte Mat Online - Use cases (Must + Should, backlog v1)
left to right direction
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5FAF7
  BorderColor #2F5D50
}
skinparam actorBorderColor #2F5D50

actor "Customer" as Customer
actor "Private customer" as Private
actor "Corporate customer" as Corporate
actor "Company admin" as CompanyAdmin
Private -|> Customer
Corporate -|> Customer
CompanyAdmin -|> Corporate

actor "Event coordinator" as Coordinator
actor "Kitchen staff" as Kitchen
actor "Head chef" as Chef
Chef -|> Kitchen
actor "Owner" as Owner
actor "Scheduler\n<<time>>" as Timer
actor "Fiken\n<<system>>" as Fiken
actor "Vipps\n<<system>>" as Vipps

rectangle "Ekte Mat Online" {
  usecase "UC01 Browse menus and prices\n[US-01, US-05, US-33, US-34]" as UC01
  usecase "UC02 Check date availability\n[US-04]" as UC02
  usecase "UC03 Submit booking request\n[US-02, US-03, US-36]" as UC03
  usecase "UC04 Download quote\n[US-06]" as UC04
  usecase "UC05 Accept quote online\n[-]" as UC05
  usecase "UC06 Change guests and allergies\n[US-11, US-36]" as UC06
  usecase "UC07 Cancel order\n[US-13]" as UC07
  usecase "UC08 Confirm final numbers\n[US-12]" as UC08
  usecase "UC09 Manage standing order\n[US-17]" as UC09
  usecase "UC10 Copy previous order\n[US-18]" as UC10
  usecase "UC11 Manage company users\n[US-16]" as UC11
  usecase "UC12 Pay with Vipps\n(deposit or invoice)\n[US-21, US-22]" as UC12
  usecase "UC13 Request data access / deletion\n[US-37, US-38]" as UC13
  usecase "UC14 Manage order list\n[US-08, US-03]" as UC14
  usecase "UC15 Register phone order\n[US-09]" as UC15
  usecase "UC16 View capacity calendar\n[US-10]" as UC16
  usecase "UC17 Send final-number reminders\n[US-12]" as UC17
  usecase "UC18 View kitchen day screen\n[US-26, US-30]" as UC18
  usecase "UC19 Confirm allergies seen\n[US-27]" as UC19
  usecase "UC20 View 3-day prep list\n[US-29]" as UC20
  usecase "UC21 Print orders\n[US-31]" as UC21
  usecase "UC22 Manage menus and dishes\n[US-32, US-33, US-34]" as UC22
  usecase "UC23 Create invoice in Fiken\n(Vipps or monthly EHF)\n[US-23, US-24]" as UC23
  usecase "UC24 Sync payment status\n[US-25]" as UC24
  usecase "UC25 Apply retention rules\n[US-39]" as UC25
  usecase "UC26 Log in with PIN\n[US-28]" as UC26
  usecase "UC27 Generate orders from standing orders\n[US-17]" as UC27
}

Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -- UC05
Customer -- UC06
Customer -- UC07
Customer -- UC08
Customer -- UC10
Customer -- UC13
Private -- UC12
Corporate -- UC09
CompanyAdmin -- UC11

Coordinator -- UC14
Coordinator -- UC15
Coordinator -- UC16
Coordinator -- UC21
Kitchen -- UC18
Kitchen -- UC19
Kitchen -- UC21
Chef -- UC20
Chef -- UC22
Owner -- UC24

Timer -- UC17
Timer -- UC23
Timer -- UC25
Timer -- UC27

UC12 -- Vipps
UC23 -- Fiken
UC24 -- Fiken
UC24 -- Vipps

UC18 ..> UC26 : <<include>>
UC19 ..> UC26 : <<include>>
UC12 ..> UC05 : <<extend>>\n[wedding deposit]
@enduml
